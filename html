           INFORMATION BOX
        ========================================= */

        .info-box {
            margin-top: 30px;

            background: #fffdf1;

            border: 1px solid #f0e6ae;

            border-radius: 18px;

            padding: 18px 22px;

            color: #756a2f;

            display: flex;

            align-items: center;

            gap: 12px;

            line-height: 1.5;
        }


        .info-icon {
            font-size: 22px;

            flex-shrink: 0;
        }


        /* =========================================
           ACTIVE VALVE SUMMARY
        ========================================= */

        .active-summary {
            margin-top: 30px;

            background: white;

            border-radius: 20px;

            padding: 22px 25px;

            border: 1px solid #e0ebe1;

            box-shadow:
                0 6px 20px rgba(20, 80, 45, 0.05);
        }


        .active-summary h3 {
            margin-bottom: 12px;

            color: #154c32;

            font-size: 21px;
        }


        .active-list {
            display: flex;

            flex-wrap: wrap;

            gap: 10px;
        }


        .active-chip {
            background: #e8f7ed;

            color: #18723f;

            padding: 9px 14px;

            border-radius: 20px;

            font-size: 14px;

            font-weight: bold;
        }


        .none-active {
            color: #8a9991;

            font-size: 14px;
        }


        /* =========================================
           FOOTER NOTE
        ========================================= */

        .page-note {
            margin-top: 25px;

            padding: 15px;

            text-align: center;

            color: #82938b;

            font-size: 13px;
        }


        /* =========================================
           RESPONSIVE - TABLET
        ========================================= */

        @media (max-width: 1100px) {

            .npk-grid {
                grid-template-columns: 1fr;
            }


            .sidebar {
                width: 230px;
            }


            .main-content {
                margin-left: 230px;

                width: calc(100% - 230px);

                padding: 30px;
            }

        }


