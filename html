            font-size: 15px;

            font-weight: bold;

            color: #557267;

            margin-bottom: 12px;
        }


        /* =========================================
           VALVE BUTTON
        ========================================= */

        .valve-button {
            width: 100%;

            border: none;

            padding: 14px 18px;

            border-radius: 13px;

            background: #edf5ee;

            color: #1a7141;

            font-size: 15px;

            font-weight: bold;

            cursor: pointer;

            transition: 0.25s;
        }


        .valve-button:hover {
            transform: translateY(-2px);

            background: #e1efe3;
        }


        .valve-button:active {
            transform: translateY(0);
        }


        .valve-button.active {
            background: #198447;

            color: white;

            box-shadow:
                0 7px 18px rgba(25, 132, 71, 0.25);
        }


        .valve-button.active:hover {
            background: #146c39;
        }


