           VALVE STATUS
        ========================================= */

        .valve-status {
            margin-top: 13px;

            font-size: 14px;

            font-weight: bold;

            display: flex;

            align-items: center;

            gap: 8px;
        }


        .status-dot {
            width: 10px;
            height: 10px;

            border-radius: 50%;

            background: #bfc9c3;
        }


        .status-dot.active {
            background: #2bc978;
        }


        .status-text {
            color: #7d8f86;
        }


        .status-text.active {
            color: #198447;
        }


