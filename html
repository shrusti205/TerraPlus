    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                function updateTerraPlusTime() {

                    const timeElement =
                        document.getElementById(
                            "currentTime"
                        );

                    if (!timeElement) {
                        return;
                    }

                    const now =
                        new Date();

                    const options = {

                        weekday: "long",

                        day: "2-digit",

                        month: "long",

                        year: "numeric",

                        hour: "2-digit",

                        minute: "2-digit",

                        second: "2-digit"

                    };

                    timeElement.textContent =
                        now.toLocaleString(
                            "en-IN",
                            options
                        );

                }


                updateTerraPlusTime();


                setInterval(
                    updateTerraPlusTime,
                    1000
