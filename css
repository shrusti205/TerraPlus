/* =========================================================
   TERRAPLUS DASHBOARD
   Complete Dashboard Styling
========================================================= */

@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap');


/* =========================================================
   GLOBAL
========================================================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}


html {
    scroll-behavior: smooth;
}


body {
    font-family: 'Poppins', Arial, sans-serif;
    background: #f4f8f1;
    color: #173b24;
    min-height: 100vh;
}


/* Remove default link styling */

a {
    text-decoration: none;
    color: inherit;
}


button,
select,
input {
    font-family: inherit;
}


/* =========================================================
   APP CONTAINER
========================================================= */

.app-container {
    display: flex;
    min-height: 100vh;
}


/* =========================================================
   SIDEBAR
========================================================= */

.sidebar {
    width: 260px;
    min-height: 100vh;

    background: linear-gradient(180deg,
            #14532d 0%,
            #1f7a3d 50%,
            #2e8b57 100%);

    color: white;

    position: fixed;
    left: 0;
    top: 0;
    bottom: 0;

    display: flex;
    flex-direction: column;

    z-index: 1000;

    box-shadow: 5px 0 25px rgba(0, 0, 0, 0.10);
}


/* =========================================================
   SIDEBAR LOGO
========================================================= */

.sidebar-logo {
    padding: 25px 20px 20px;

    display: flex;
    justify-content: center;
    align-items: center;
}


.logo-image {
    width: 145px;
    max-width: 100%;
    height: auto;

    display: block;

    background: white;

    padding: 8px;

    border-radius: 14px;

    object-fit: contain;
}


/* =========================================================
   NAVIGATION
========================================================= */

.sidebar-navigation {
    padding: 10px 15px;
}


.menu-title {
    font-size: 11px;
    font-weight: 700;

    letter-spacing: 1.5px;

    text-transform: uppercase;

    color: rgba(255, 255, 255, 0.65);

    margin: 15px 12px 12px;
}


.nav-item {
    display: flex;
    align-items: center;

    gap: 13px;

    padding: 13px 15px;

    margin-bottom: 5px;

    border-radius: 12px;

    color: rgba(255, 255, 255, 0.85);

    font-size: 14px;
    font-weight: 500;

    transition:
        background 0.25s ease,
        transform 0.25s ease,
        color 0.25s ease;
}


.nav-item:hover {
    background: rgba(255, 255, 255, 0.13);

    color: white;

    transform: translateX(3px);
}


.nav-item.active {
    background: white;

    color: #176333;

    font-weight: 700;

    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.12);
}


.nav-icon {
    width: 25px;

    font-size: 18px;

    text-align: center;
}


/* =========================================================
   SIDEBAR BOTTOM
========================================================= */

.sidebar-bottom {
    margin-top: auto;

    padding: 20px;
}


.demo-status {
    display: flex;
    align-items: center;

    gap: 8px;

    padding: 10px 12px;

    margin-bottom: 12px;

    background: rgba(255, 255, 255, 0.10);

    border-radius: 10px;

    font-size: 12px;
}


.status-dot {
    width: 9px;
    height: 9px;

    background: #76e68b;

    border-radius: 50%;

    display: inline-block;

    box-shadow: 0 0 8px #76e68b;
}


.logout-button {
    width: 100%;

    border: 1px solid rgba(255, 255, 255, 0.25);

    background: rgba(255, 255, 255, 0.08);

    color: white;

    padding: 11px;

    border-radius: 10px;

    cursor: pointer;

    font-size: 13px;

    transition: 0.25s;
}


.logout-button:hover {
    background: rgba(255, 255, 255, 0.18);
}


/* =========================================================
   MAIN CONTENT
========================================================= */

.main-content {
    margin-left: 260px;

    width: calc(100% - 260px);

    min-height: 100vh;

    padding: 0 35px 50px;
}


/* =========================================================
   TOPBAR
========================================================= */

.topbar {
    height: 90px;

    display: flex;

    justify-content: space-between;

    align-items: center;

    border-bottom: 1px solid #e1eadf;

    margin-bottom: 30px;
}


.topbar-left {
    display: flex;
    align-items: center;

    gap: 15px;
}


.page-title {
    font-size: 22px;

    font-weight: 800;

    color: #14532d;
}


.page-subtitle {
    color: #78917f;

    font-size: 12px;

    margin-top: 2px;
}


.topbar-right {
    display: flex;
    align-items: center;

    gap: 18px;
}


/* =========================================================
   MENU BUTTON
========================================================= */

.menu-toggle {
    display: none;

    width: 42px;
    height: 42px;

    border: none;

    border-radius: 10px;

    background: #e9f4e9;

    color: #176333;

    font-size: 20px;

    cursor: pointer;
}


/* =========================================================
   LANGUAGE
========================================================= */

.language-selector {
    display: flex;

    align-items: center;

    gap: 6px;

    background: white;

    padding: 8px 12px;

    border-radius: 10px;

    border: 1px solid #dce8db;
}


.language-selector select {
    border: none;

    outline: none;

    background: transparent;

    color: #245b35;

    font-size: 13px;

    cursor: pointer;
}


/* =========================================================
   ICON BUTTON
========================================================= */

.icon-button {
    width: 42px;
    height: 42px;

    border: 1px solid #dce8db;

    background: white;

    border-radius: 10px;

    cursor: pointer;

    font-size: 17px;

    transition: 0.25s;
}


.icon-button:hover {
    background: #eaf5e8;

    transform: translateY(-2px);
}


/* =========================================================
   USER PROFILE
========================================================= */

.user-profile {
    display: flex;

    align-items: center;

    gap: 10px;
}


.user-avatar {
    width: 40px;
    height: 40px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background: #e8f5e9;

    font-size: 21px;
}


.user-info {
    display: flex;

    flex-direction: column;
}


.user-info strong {
    font-size: 13px;

    color: #183c25;
}


.user-info span {
    font-size: 10px;

    color: #7a9180;
}


/* =========================================================
   CONTENT SECTION
========================================================= */

.content-section {
    display: none;

    animation: fadeIn 0.35s ease;
}


.content-section.active-section {
    display: block;
}


@keyframes fadeIn {

    from {
        opacity: 0;

        transform: translateY(8px);
    }

    to {
        opacity: 1;

        transform: translateY(0);
    }

}


/* =========================================================
   WELCOME
========================================================= */

.welcome-section {
    display: flex;

    justify-content: space-between;

    align-items: center;

    margin-bottom: 28px;
}


.welcome-section h1 {
    font-size: 28px;

    color: #173b24;

    margin-bottom: 6px;
}


.welcome-section p {
    color: #738879;

    font-size: 14px;
}


.current-time {
    background: white;

    padding: 12px 16px;

    border-radius: 12px;

    border: 1px solid #e2ebdf;

    color: #577260;

    font-size: 12px;

    box-shadow: 0 4px 15px rgba(30, 80, 40, 0.05);
}


/* =========================================================
   SENSOR GRID
========================================================= */

.sensor-grid {
    display: grid;

    grid-template-columns:
        repeat(4, minmax(0, 1fr));

    gap: 18px;

    margin-bottom: 30px;
}


.sensor-card {
    background: white;

    border-radius: 18px;

    padding: 20px;

    border: 1px solid #e1ebdf;

    box-shadow:
        0 6px 20px rgba(32, 83, 42, 0.06);

    transition: 0.25s;
}


.sensor-card:hover {
    transform: translateY(-4px);

    box-shadow:
        0 12px 25px rgba(32, 83, 42, 0.10);
}


.sensor-card-header {
    display: flex;

    align-items: center;

    gap: 10px;

    margin-bottom: 15px;
}


.sensor-icon {
    width: 42px;
    height: 42px;

    border-radius: 12px;

    background: #edf7eb;

    display: flex;

    align-items: center;
    justify-content: center;

    font-size: 22px;
}


.sensor-label {
    font-size: 13px;

    font-weight: 600;

    color: #607766;
}


.sensor-value {
    display: flex;

    align-items: baseline;

    gap: 4px;

    margin-bottom: 12px;
}


.sensor-value span:first-child {
    font-size: 30px;

    font-weight: 800;

    color: #183d25;
}


.sensor-value .unit {
    font-size: 14px;

    color: #7d9080;
}


.sensor-status {
    display: flex;

    align-items: center;

    gap: 6px;

    font-size: 12px;

    font-weight: 600;
}


.sensor-status.normal {
    color: #32834b;
}


/* =========================================================
   NPK MINI VALUES
========================================================= */

.npk-mini-values {
    display: flex;

    gap: 10px;

    margin-bottom: 12px;
}


.npk-mini-values>div {
    flex: 1;

    text-align: center;

    background: #f5f8f3;

    border-radius: 9px;

    padding: 7px 4px;
}


.npk-mini-values strong {
    display: block;

    font-size: 18px;

    color: #245e34;
}


.npk-mini-values small {
    color: #809081;

    font-weight: 600;
}


/* =========================================================
   SECTION HEADING
========================================================= */

.section-heading {
    display: flex;

    justify-content: space-between;

    margin-bottom: 15px;
}


.section-heading h2 {
    font-size: 19px;

    color: #1a4027;
}


.section-heading p {
    font-size: 12px;

    color: #7b8e7e;

    margin-top: 3px;
}


/* =========================================================
   QUICK ACTIONS
========================================================= */

.quick-actions {
    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    gap: 15px;

    margin-bottom: 30px;
}


.quick-action-card {
    border: none;

    background: white;

    border: 1px solid #e1ebdf;

    border-radius: 15px;

    padding: 17px;

    cursor: pointer;

    color: #285d35;

    font-size: 13px;

    font-weight: 600;

    display: flex;

    align-items: center;

    justify-content: center;

    gap: 9px;

    box-shadow: 0 4px 14px rgba(30, 80, 40, 0.05);

    transition: 0.25s;
}


.quick-action-card:hover {
    background: #edf8eb;

    transform: translateY(-3px);
}


.quick-icon {
    font-size: 20px;
}


/* =========================================================
   CHART CARD
========================================================= */

.chart-card {
    background: white;

    border: 1px solid #e1ebdf;

    border-radius: 18px;

    padding: 22px;

    margin-bottom: 25px;

    box-shadow: 0 5px 18px rgba(30, 80, 40, 0.05);
}


.chart-header {
    display: flex;

    align-items: center;

    justify-content: space-between;

    margin-bottom: 20px;
}


.chart-header h2 {
    font-size: 18px;

    color: #183d25;
}


.chart-header p {
    color: #7b8e7e;

    font-size: 12px;

    margin-top: 3px;
}


.chart-header select {
    border: 1px solid #dbe7d9;

    border-radius: 9px;

    padding: 8px 12px;

    background: #f8fbf7;

    color: #46614c;

    outline: none;
}


.chart-container {
    width: 100%;

    height: 300px;

    position: relative;
}


.chart-container canvas {
    width: 100% !important;

    height: 100% !important;
}


/* =========================================================
   PAGE HEADER
========================================================= */

.page-header {
    margin-bottom: 25px;
}


.page-header h1 {
    font-size: 28px;

    color: #173b24;

    margin-bottom: 5px;
}


.page-header p {
    color: #748878;

    font-size: 13px;
}


/* =========================================================
   ANALYTICS GRID
========================================================= */

.analytics-grid {
    display: grid;

    grid-template-columns:
        repeat(2, 1fr);

    gap: 20px;
}


/* =========================================================
   NPK CONTROL
========================================================= */

.npk-control-grid {
    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 20px;

    margin-bottom: 25px;
}


.npk-control-card {
    background: white;

    border-radius: 18px;

    padding: 25px;

    border: 1px solid #e2ebe0;

    text-align: center;

    box-shadow: 0 6px 18px rgba(30, 80, 40, 0.06);
}


.npk-control-icon {
    font-size: 42px;

    margin-bottom: 10px;
}


.npk-control-card h2 {
    color: #1b4727;

    font-size: 19px;

    margin-bottom: 4px;
}


.npk-control-card p {
    color: #829182;

    font-size: 12px;

    margin-bottom: 18px;
}


.npk-reading {
    margin-bottom: 15px;
}


.npk-reading strong {
    font-size: 32px;

    color: #245d34;
}


.npk-reading span {
    color: #819080;

    font-size: 12px;
}


.valve-status {
    font-size: 11px;

    color: #55815e;

    margin-bottom: 18px;
}


.valve-status .status-dot {
    width: 7px;
    height: 7px;

    margin-right: 5px;
}


.control-button {
    border: none;

    width: 100%;

    padding: 12px;

    border-radius: 10px;

    background: #24733c;

    color: white;

    font-weight: 600;

    cursor: pointer;

    transition: 0.25s;
}


.control-button:hover {
    background: #185c2d;

    transform: translateY(-2px);
}


/* =========================================================
   INFO BOX
========================================================= */

.info-box {
    display: flex;

    align-items: flex-start;

    gap: 14px;

    background: #edf7eb;

    border: 1px solid #d6e9d2;

    border-radius: 15px;

    padding: 18px;
}


.info-icon {
    font-size: 25px;
}


.info-box strong {
    color: #245c32;
}


.info-box p {
    color: #617764;

    font-size: 12px;

    margin-top: 4px;

    line-height: 1.6;
}


/* =========================================================
   IRRIGATION
========================================================= */

.irrigation-card {
    background: white;

    border-radius: 20px;

    padding: 30px;

    border: 1px solid #e1ebdf;

    box-shadow: 0 6px 20px rgba(30, 80, 40, 0.06);
}


.irrigation-status {
    display: flex;

    align-items: center;

    gap: 18px;

    margin-bottom: 30px;
}


.large-water-icon {
    width: 70px;
    height: 70px;

    border-radius: 18px;

    display: flex;

    align-items: center;
    justify-content: center;

    background: #e7f5fb;

    font-size: 35px;
}


.irrigation-status h2 {
    color: #1c4728;

    margin-bottom: 4px;
}


.irrigation-status p {
    color: #788a7c;

    font-size: 13px;
}


.irrigation-controls {
    display: flex;

    gap: 15px;

    margin-bottom: 20px;
}


.irrigation-controls button {
    flex: 1;

    border: none;

    padding: 14px;

    border-radius: 11px;

    font-weight: 700;

    cursor: pointer;

    transition: 0.25s;
}


.irrigation-on {
    background: #e4f5e8;

    color: #26713b;
}


.irrigation-on:hover {
    background: #cdebd4;
}


.irrigation-off {
    background: #fce8e8;

    color: #b33a3a;
}


.irrigation-off:hover {
    background: #f7d4d4;
}


.relay-information {
    padding-top: 18px;

    border-top: 1px solid #edf1eb;

    font-size: 13px;

    color: #6f8172;
}


.relay-information strong {
    color: #c24444;

    margin-left: 5px;
}


/* =========================================================
   DEVICES
========================================================= */

.devices-grid {
    display: grid;

    grid-template-columns:
        repeat(2, 1fr);

    gap: 16px;
}


.device-card {
    display: flex;

    align-items: center;

    gap: 15px;

    background: white;

    border: 1px solid #e1ebdf;

    padding: 18px;

    border-radius: 15px;

    box-shadow: 0 4px 15px rgba(30, 80, 40, 0.04);
}


.device-icon {
    width: 48px;
    height: 48px;

    border-radius: 13px;

    display: flex;

    align-items: center;
    justify-content: center;

    background: #edf7eb;

    font-size: 24px;
}


.device-card h3 {
    color: #214a2c;

    font-size: 14px;
}


.device-card p {
    color: #849185;

    font-size: 11px;

    margin-top: 3px;
}


.device-online {
    margin-left: auto;

    color: #318349;

    font-size: 11px;

    font-weight: 600;
}


/* =========================================================
   SETTINGS
========================================================= */

.settings-card {
    background: white;

    border: 1px solid #e1ebdf;

    border-radius: 18px;

    overflow: hidden;
}


.setting-row {
    display: flex;

    align-items: center;

    justify-content: space-between;

    padding: 22px;

    border-bottom: 1px solid #edf1eb;
}


.setting-row:last-child {
    border-bottom: none;
}


.setting-row h3 {
    color: #254d30;

    font-size: 14px;
}


.setting-row p {
    color: #839083;

    font-size: 11px;

    margin-top: 4px;
}


.setting-row select {
    border: 1px solid #dbe7d9;

    padding: 9px 12px;

    border-radius: 8px;

    background: #f8fbf7;

    color: #315d3b;
}


/* =========================================================
   TOGGLE SWITCH
========================================================= */

.switch {
    position: relative;

    width: 48px;
    height: 26px;

    display: inline-block;
}


.switch input {
    opacity: 0;

    width: 0;
    height: 0;
}


.slider {
    position: absolute;

    inset: 0;

    background: #d8e2d7;

    border-radius: 30px;

    cursor: pointer;

    transition: 0.25s;
}


.slider:before {
    content: "";

    position: absolute;

    width: 20px;
    height: 20px;

    left: 3px;
    top: 3px;

    background: white;

    border-radius: 50%;

    transition: 0.25s;

    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.15);
}


.switch input:checked+.slider {
    background: #278043;
}


.switch input:checked+.slider:before {
    transform: translateX(22px);
}


/* =========================================================
   NOTIFICATION POPUP
========================================================= */

.notification-popup {
    position: fixed;

    right: 25px;

    bottom: 25px;

    width: 320px;

    display: flex;

    align-items: center;

    gap: 12px;

    padding: 15px;

    background: white;

    border: 1px solid #dfe9dd;

    border-radius: 14px;

    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.12);

    transform: translateY(150px);

    opacity: 0;

    pointer-events: none;

    transition: 0.35s;

    z-index: 2000;
}


.notification-popup.show {
    transform: translateY(0);

    opacity: 1;
}


.notification-icon {
    width: 42px;
    height: 42px;

    background: #edf7eb;

    border-radius: 10px;

    display: flex;

    align-items: center;
    justify-content: center;

    font-size: 20px;
}


.notification-popup strong {
    font-size: 13px;

    color: #23492c;
}


.notification-popup p {
    font-size: 11px;

    color: #7a897c;

    margin-top: 2px;
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 1100px) {

    .sensor-grid {
        grid-template-columns:
            repeat(2, 1fr);
    }


    .quick-actions {
        grid-template-columns:
            repeat(2, 1fr);
    }


    .npk-control-grid {
        grid-template-columns:
            1fr;
    }

}


@media (max-width: 850px) {

    .sidebar {
        transform: translateX(-100%);

        transition: transform 0.3s ease;
    }


    .sidebar.open {
        transform: translateX(0);
    }


    .main-content {
        margin-left: 0;

        width: 100%;

        padding: 0 18px 40px;
    }


    .menu-toggle {
        display: block;
    }


    .topbar {
        height: 75px;
    }


    .user-info {
        display: none;
    }


    .analytics-grid {
        grid-template-columns: 1fr;
    }


    .devices-grid {
        grid-template-columns: 1fr;
    }

}


@media (max-width: 600px) {

    .topbar-right {
        gap: 8px;
    }


    .language-selector {
        padding: 7px;
    }


    .language-selector span {
        display: none;
    }


    .sensor-grid {
        grid-template-columns: 1fr;
    }


    .quick-actions {
        grid-template-columns: 1fr;
    }


    .welcome-section {
        flex-direction: column;

        align-items: flex-start;

        gap: 15px;
    }


    .welcome-section h1 {
        font-size: 23px;
    }


    .chart-container {
        height: 250px;
    }


    .irrigation-controls {
        flex-direction: column;
    }


    .setting-row {
        gap: 15px;
    }


    .notification-popup {
        left: 15px;

        right: 15px;

        width: auto;
    }

}

/* =========================================================
   TERRAPLUS NPK PAGE
========================================================= */

.page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 30px;
    margin-bottom: 30px;
}

.page-header h1 {
    margin: 8px 0;
    font-size: 38px;
    font-weight: 800;
}

.page-header p {
    margin: 0;
    font-size: 16px;
    opacity: 0.75;
}

.system-status {
    background: #ffffff;
    border: 1px solid #dce8dc;
    border-radius: 14px;
    padding: 14px 20px;
    display: flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
}

.status-dot {
    width: 11px;
    height: 11px;
    background: #35c978;
    border-radius: 50%;
    display: inline-block;
}


/* =========================================================
   NPK SUMMARY
========================================================= */

.npk-summary {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
    margin-bottom: 35px;
}

.summary-card {
    background: #ffffff;
    border: 1px solid #e0e9df;
    border-radius: 20px;
    padding: 24px;
    display: flex;
    align-items: center;
    gap: 18px;
    box-shadow: 0 8px 25px rgba(30, 90, 45, 0.06);
}

.summary-icon {
    width: 55px;
    height: 55px;
    border-radius: 16px;
    background: #edf7ed;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 28px;
}

.summary-card span {
    display: block;
    font-size: 14px;
    opacity: 0.7;
}

.summary-card strong {
    display: inline-block;
    font-size: 30px;
    margin-top: 5px;
}

.summary-card small {
    margin-left: 5px;
    opacity: 0.65;
}


/* =========================================================
   VALVE GRID
========================================================= */

.valve-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
}

.valve-card {
    background: #ffffff;
    border: 1px solid #e1e9df;
    border-radius: 22px;
    padding: 24px;
    box-shadow: 0 8px 25px rgba(30, 90, 45, 0.06);
    transition: 0.25s ease;
}

.valve-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 30px rgba(30, 90, 45, 0.10);
}

.valve-card.active-valve {
    border: 2px solid #32a852;
    box-shadow: 0 10px 30px rgba(50, 168, 82, 0.15);
}


/* =========================================================
   VALVE HEADER
========================================================= */

.valve-header {
    display: flex;
    align-items: center;
    gap: 14px;
}

.valve-letter {
    width: 50px;
    height: 50px;
    border-radius: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 23px;
    font-weight: 800;
}

.valve-letter.nitrogen {
    background: #e9f6e9;
    color: #23843b;
}

.valve-letter.phosphorus {
    background: #fff4df;
    color: #bd7a13;
}

.valve-letter.potassium {
    background: #e9f0ff;
    color: #426cc4;
}

.valve-header h3 {
    margin: 0;
    font-size: 19px;
}

.valve-header span {
    font-size: 13px;
    opacity: 0.65;
}

.valve-status {
    margin-left: auto;
    padding: 7px 11px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 800;
}

.valve-off {
    background: #f0f2f0;
    color: #777;
}

.valve-on {
    background: #ddf7e5;
    color: #1b9142;
}


/* =========================================================
   BOTTLE
========================================================= */

.bottle-display {
    margin: 25px 0;
    padding: 24px;
    border-radius: 18px;
    background: #f7faf6;
    text-align: center;
    font-size: 42px;
}

.bottle-display span {
    display: block;
    margin-top: 8px;
    font-size: 13px;
    opacity: 0.7;
}


/* =========================================================
   VALVE DETAILS
========================================================= */

.valve-details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 20px;
}

.valve-details div {
    background: #f6f9f5;
    border-radius: 13px;
    padding: 12px;
}

.valve-details span {
    display: block;
    font-size: 12px;
    opacity: 0.65;
}

.valve-details strong {
    display: block;
    margin-top: 5px;
}


/* =========================================================
   VALVE BUTTON
========================================================= */

.valve-button {
    width: 100%;
    border: none;
    border-radius: 13px;
    padding: 14px;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    background: #e8f5e9;
    color: #176c31;
    transition: 0.2s ease;
}

.valve-button:hover {
    background: #d8f0dc;
}

.valve-button.valve-active {
    background: #ffe7e5;
    color: #b82e25;
}


/* =========================================================
   APPLICATION
========================================================= */

.application-section {
    margin-top: 40px;
}

.application-card {
    background: #ffffff;
    border: 1px solid #e0e9df;
    border-radius: 22px;
    padding: 28px;
    box-shadow: 0 8px 25px rgba(30, 90, 45, 0.06);
}

.application-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
}

.input-group label {
    display: block;
    margin-bottom: 8px;
    font-weight: 700;
}

.input-group select {
    width: 100%;
    padding: 14px;
    border: 1px solid #d9e4d8;
    border-radius: 12px;
    background: #ffffff;
    font-size: 15px;
}

.apply-button {
    width: 100%;
    margin-top: 22px;
    border: none;
    border-radius: 14px;
    padding: 15px;
    background: #1f7a3f;
    color: #ffffff;
    font-size: 16px;
    font-weight: 800;
    cursor: pointer;
}

.apply-button:hover {
    background: #176531;
}

.application-message {
    margin: 15px 0 0;
    text-align: center;
    opacity: 0.7;
}


/* =========================================================
   CHART
========================================================= */

.chart-container {
    width: 100%;
    height: 390px;
    background: #ffffff;
    border: 1px solid #e0e9df;
    border-radius: 22px;
    padding: 25px;
    box-sizing: border-box;
    box-shadow: 0 8px 25px rgba(30, 90, 45, 0.06);
}


/* =========================================================
   WARNING
========================================================= */

.warning-section {
    margin-top: 30px;
}

.warning-box {
    background: #fff9e9;
    border: 1px solid #f0dfad;
    border-radius: 18px;
    padding: 20px;
    display: flex;
    align-items: center;
    gap: 15px;
}

.warning-icon {
    font-size: 30px;
}

.warning-box h3 {
    margin: 0 0 5px;
}

.warning-box p {
    margin: 0;
    opacity: 0.75;
}


/* =========================================================
   NOTIFICATION
========================================================= */

.notification-popup {
    position: fixed;
    right: 25px;
    bottom: 25px;
    background: #ffffff;
    border: 1px solid #dbe7da;
    border-radius: 15px;
    padding: 15px 20px;
    display: flex;
    align-items: center;
    gap: 10px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
    transform: translateY(120px);
    opacity: 0;
    pointer-events: none;
    transition: 0.3s ease;
    z-index: 9999;
}

.notification-popup.show {
    transform: translateY(0);
    opacity: 1;
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 1000px) {

    .valve-grid {
        grid-template-columns: 1fr;
    }

    .npk-summary {
        grid-template-columns: 1fr;
    }

}


@media (max-width: 700px) {

    .page-header {
        flex-direction: column;
        align-items: flex-start;
    }

    .application-row {
        grid-template-columns: 1fr;
    }

    .chart-container {
        height: 300px;
    }

}

