/* RESET */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}


/* BODY */

body {

    font-family:
        Arial,
        "Segoe UI",
        sans-serif;

    color: #253329;

    min-height: 100vh;

}


/* =========================================
   PAGE BACKGROUND
========================================= */

.login-page {

    min-height: 100vh;

    display: flex;

    justify-content: center;

    align-items: center;

    padding: 40px 20px;

    background:

        radial-gradient(circle at top left,
            rgba(87, 142, 73, 0.16),
            transparent 35%),

        radial-gradient(circle at bottom right,
            rgba(214, 177, 63, 0.14),
            transparent 35%),

        #f4f8f1;

}


/* =========================================
   MAIN CONTAINER
========================================= */

.login-container {

    width: 100%;

    max-width: 470px;

    text-align: center;

}


/* =========================================
   LOGIN CARD
========================================= */

.login-card {

    width: 100%;

    background: rgba(255, 255, 255, 0.97);

    border-radius: 24px;

    padding: 38px 36px 35px;

    text-align: left;

    border: 1px solid rgba(56, 110, 59, 0.10);

    box-shadow:

        0 18px 50px rgba(46, 92, 51, 0.14);

}


/* =========================================
   TERRAPLUS LOGO
   INSIDE LOGIN CARD
========================================= */

.login-logo {

    display: flex;

    justify-content: center;

    align-items: center;

    margin-bottom: 18px;

}


/* LOGO IMAGE */

.login-logo img {

    width: 125px;

    height: 125px;

    object-fit: contain;

    display: block;

}


/* =========================================
   WELCOME TITLE
========================================= */

.login-card h1 {

    text-align: center;

    font-size: 32px;

    font-weight: 700;

    color: #253b2a;

    margin-bottom: 8px;

}


/* SUBTITLE */

.login-subtitle {

    text-align: center;

    color: #718073;

    font-size: 16px;

    margin-bottom: 30px;

}


/* =========================================
   INPUT GROUP
========================================= */

.input-group {

    margin-bottom: 20px;

}


/* LABEL */

.input-group label {

    display: block;

    margin-bottom: 8px;

    font-size: 15px;

    font-weight: 600;

    color: #405244;

}


/* INPUT */

.input-group input {

    width: 100%;

    padding: 15px 16px;

    border-radius: 13px;

    border: 1px solid #d6dfd3;

    background: #fbfdf9;

    font-size: 16px;

    outline: none;

    transition: 0.25s ease;

}


/* INPUT FOCUS */

.input-group input:focus {

    border-color: #4c8a50;

    box-shadow:

        0 0 0 4px rgba(76, 138, 80, 0.12);

}


/* PLACEHOLDER */

.input-group input::placeholder {

    color: #a1aaa2;

}


/* =========================================
   LOGIN OPTIONS
========================================= */

.login-options {

    display: flex;

    justify-content: space-between;

    align-items: center;

    gap: 15px;

    margin-bottom: 25px;

    font-size: 14px;

}


/* REMEMBER */

.remember-me {

    display: flex;

    align-items: center;

    gap: 8px;

    color: #647067;

    cursor: pointer;

}


.remember-me input {

    accent-color: #3f7d42;

}


/* FORGOT PASSWORD */

.forgot-password {

    border: none;

    background: transparent;

    color: #3f7d42;

    font-size: 14px;

    cursor: pointer;

}


.forgot-password:hover {

    text-decoration: underline;

}


/* =========================================
   LOGIN BUTTON
========================================= */

.login-button {

    width: 100%;

    border: none;

    border-radius: 13px;

    padding: 15px;

    background: #3f7d42;

    color: white;

    font-size: 17px;

    font-weight: 600;

    cursor: pointer;

    display: flex;

    justify-content: center;

    align-items: center;

    gap: 12px;

    transition: 0.25s ease;

}


.login-button:hover {

    background: #336b37;

    transform: translateY(-2px);

    box-shadow:

        0 10px 22px rgba(63, 125, 66, 0.25);

}


.login-button:active {

    transform: translateY(0);

}


/* =========================================
   PLATFORM INFO
========================================= */

.platform-info {

    margin-top: 22px;

    padding: 14px 16px;

    border-radius: 14px;

    background: #f0f7ed;

    display: flex;

    align-items: center;

    gap: 12px;

}


.platform-icon {

    font-size: 25px;

}


.platform-info strong {

    display: block;

    font-size: 14px;

    color: #3d6140;

}


.platform-info small {

    display: block;

    margin-top: 3px;

    font-size: 12px;

    color: #849084;

}


/* =========================================
   LANGUAGE SELECTOR
========================================= */

.language-selector {

    display: flex;

    justify-content: center;

    gap: 8px;

    margin-top: 22px;

}


.language-button {

    border: 1px solid #d4ddd2;

    background: rgba(255, 255, 255, 0.75);

    color: #627063;

    padding: 8px 14px;

    border-radius: 20px;

    font-size: 13px;

    cursor: pointer;

    transition: 0.2s ease;

}


.language-button:hover {

    border-color: #4f8b52;

    color: #3f7d42;

}


.language-button.active {

    background: #3f7d42;

    border-color: #3f7d42;

    color: white;

}


/* =========================================
   FOOTER
========================================= */

.login-footer {

    margin-top: 20px;

    color: #849084;

    font-size: 12px;

    line-height: 1.8;

}


/* =========================================
   MOBILE
========================================= */

@media (max-width: 600px) {

    .login-page {

        padding: 25px 15px;

    }


    .login-card {

        padding: 30px 20px;

        border-radius: 20px;

    }


    .login-logo img {

        width: 105px;

        height: 105px;

    }


    .login-card h1 {

        font-size: 27px;

    }


    .login-subtitle {

        font-size: 14px;

    }


    .login-options {

        flex-direction: column;

        align-items: flex-start;

    }

}

/* ============================================================
   TERRAPLUS PASSWORD REVEAL
   ============================================================ */

.password-wrapper {
    position: relative;
    width: 100%;
}

.password-wrapper input {
    width: 100%;
    padding-right: 52px;
    box-sizing: border-box;
}

.password-toggle {
    position: absolute;

    right: 10px;
    top: 50%;

    transform: translateY(-50%);

    width: 38px;
    height: 38px;

    padding: 0;

    border: none;

    background: transparent;

    display: flex;
    align-items: center;
    justify-content: center;

    cursor: pointer;

    font-size: 19px;

    border-radius: 8px;

    z-index: 5;
}

.password-toggle:hover {
    background: rgba(50, 131, 75, 0.08);
}

.password-toggle:active {
    transform: translateY(-50%) scale(0.95);
}

.password-toggle:focus {
    outline: 2px solid rgba(50, 131, 75, 0.25);
    outline-offset: 2px;
}
    }

    .setting-row {
        align-items: flex-start;
        flex-direction: column;
    }
}
